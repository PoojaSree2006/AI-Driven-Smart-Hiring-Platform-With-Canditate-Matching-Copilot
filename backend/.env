# ==============================
# AI Recruitment Copilot - Environment Variables
# ==============================
# This file lives at the project root (same level as /frontend and /backend).
# config.py reads this automatically via pydantic-settings.
#
# NOTE FOR THE TEAM:
# Add `.env` to .gitignore and share real DB credentials privately
# (e.g. via a team password manager), or commit a `.env.example`
# with placeholder values instead of this file.
# ==============================

# --- App Metadata ---
APP_NAME="AI Recruitment Copilot API"
APP_VERSION="1.0.0"
DEBUG=True

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- MySQL Database ---
# Each teammate should create a local database first:
#   CREATE DATABASE recruitment_copilot CHARACTER SET utf8mb4;
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=recruitment_copilot

# --- Upload Rules ---
MAX_FILE_SIZE_MB=10

# --- CORS ---
# Comma-separated origins aren't parsed automatically by pydantic-settings
# for list fields via .env in a simple way, so CORS_ORIGINS stays defined
# directly in config.py's Settings defaults instead.
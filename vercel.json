{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/candidates",
      "destination": "/api/index.py"
    },
    {
      "source": "/candidates/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/candidate/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/jobs",
      "destination": "/api/index.py"
    },
    {
      "source": "/jobs/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/job/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/upload",
      "destination": "/api/index.py"
    },
    {
      "source": "/upload/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/matching/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/interview/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/analytics/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/frontend-html/dashboard.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend-html/$1"
    }
  ]
}

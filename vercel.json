{
  "version": 2,
  "builds": [
    {
      "src": "backend/app/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend-html/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "frontend-html/dashboard.html"
    },
    {
      "src": "^/(.*\\.(html|js|css|png|jpg|jpeg|svg|ico|woff|woff2|json))$",
      "dest": "frontend-html/$1"
    },
    {
      "src": "/(.*)",
      "dest": "backend/app/main.py"
    }
  ]
}

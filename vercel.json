{
  "builds": [
    {
      "src": "backend/app/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend-html/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/docs",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/openapi.json",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/jobs(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/job(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/candidates(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/candidate(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/interview(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/upload(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/analytics(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/matching(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend-html/$1"
    }
  ]
}

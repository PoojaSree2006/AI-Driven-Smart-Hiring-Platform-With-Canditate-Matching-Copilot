@'
{
  "rewrites": [
    {
      "source": "/docs",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/openapi.json",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/jobs/:path*",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/job/:path*",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/candidates/:path*",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/candidate/:path*",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/interview/:path*",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/upload/:path*",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/analytics/:path*",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/matching/:path*",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/",
      "destination": "frontend-html/dashboard.html"
    },
    {
      "source": "/:path*",
      "destination": "frontend-html/:path*"
    }
  ]
}
'@ | Set-Content -Path vercel.json -Encoding utf8